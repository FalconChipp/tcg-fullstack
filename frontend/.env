# Environment variables for the Next.js frontend
# Update the values as needed for your local development setup

# GraphQL API endpoint
# NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://backendtcg.sixbyfive.com/graphql
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql

# Base URL of the backend server (used for uploads)
# NEXT_PUBLIC_BACKEND_URL=https://backendtcg.sixbyfive.com/graphql
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql


NEXT_PUBLIC_API_URL=http://localhost:4000/

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key

# Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

