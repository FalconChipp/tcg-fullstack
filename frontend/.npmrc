# frontend/.npmrc

# Keep public packages on npmjs
registry=https://registry.npmjs.org/

# Route your @sixbyfive scope to GitHub Packages
@sixbyfive:registry=https://npm.pkg.github.com

# CHANGED: ensure npm always sends auth to this registry
# always-auth=true

# CHANGED: the auth line needs the leading `//` and uses the CI env var
# (do NOT quote the value; Netlify injects NODE_AUTH_TOKEN at build time)
 //npm.pkg.github.com/:_authToken=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
