  "private": true,
  "packageManager": "npm@11.4.1",
  "scripts": {
    "preinstall": "echo \"CWD=$(pwd)\" && echo \"🔎 userconfig=$(npm config get userconfig)\" && echo \"🔎 @sixbyfive registry=$(npm config get @sixbyfive:registry)\" && node -e \"console.log('🔎 NODE_AUTH_TOKEN set:', !!process.env.NODE_AUTH_TOKEN)\"",
