{
  "name": "sixbyfive-tcg-backend",
  "version": "1.3.0",
  "description": "Modern Pokémon TCG backend API with Apollo Server, Express, and full marketplace/auth/user features.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "migrate": "sequelize db:migrate",
    "seed": "sequelize db:seed:all",
    "lint": "eslint .",
    "check:sdl": "node scripts/find-bad-sdl.cjs",
"test": "vitest --ui --open --coverage --reporter=default --reporter=html --reporter=json --reporter=junit --outputFile.html=./reports/vitest-report.html --outputFile.json=./reports/vitest-results.json --outputFile.junit=./reports/junit.xml",    "monitor": "node monitor.js"
  },
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@graphql-tools/merge": "^9.0.24",
    "@tensorflow/tfjs-node": "^4.22.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.0.0",
    "express-status-monitor": "^1.3.3",
    "google-auth-library": "^8.9.0",
    "graphql": "^16.8.1",
    "graphql-tag": "^2.12.6",
    "helmet": "^7.1.2",
    "jsonwebtoken": "^9.0.2",
    "mailgen": "^2.0.25",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "mysql2": "^3.10.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.12",
    "nsfwjs": "^4.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.5",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.2",
    "sequelize-cli": "^6.6.1",
    "sharp": "^0.33.4",
    "socket.io": "^4.7.5",
    "speakeasy": "^2.0.0",
    "sqlite3": "^5.1.7",
    "stripe": "^14.17.0",
    "tesseract.js": "^6.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.10.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "c8": "^10.1.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "sirv": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Ryan Chippendale / SixByFive",
  "license": "MIT"
}
