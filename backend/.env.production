########################################
# Search & Price Fetch Settings
########################################
# NOTE: PRICE_FETCH_TIMEOUT_MS is deprecated — use PRICE_TIMEOUT_MS.
# PRICE_FETCH_TIMEOUT_MS=5000
PRICE_TIMEOUT_MS=0                 # 0 = no hard timeout for pricing (more reliable in prod)
PRICE_CONCURRENCY=6                # safe concurrency for enrichment workers
SEARCH_FETCH_TIMEOUT_MS=8000       # TCGdex search timeout

# Fast path & first-pass pricing (keep responses snappy)
SEARCH_FAST_PATH=1                 # return immediately with first-pass pricing
SEARCH_ENRICH_ASYNC=1              # do enrichment in background
SEARCH_SYNC_ENRICH_LIMIT=3         # small slice scheduled async (still used to split the batch)
FIRST_PASS_PRICE_MAX=8             # how many cards to attach quick prices to
PRECISE_SYNC_PRICE_MAX=3           # small live price budget for precise queries
BULK_SET_PRICE_CACHE_TTL_MS=180000 # 3 minutes for set-level price warm cache

# DISABLE_PRICE_ENRICHMENT=1       # uncomment to fully disable enrichment during incidents
# DEBUG_PRICE=1                    # verbose price logging (leave off in prod)

########################################
# TCGdex API tuning
########################################
TCGDEX_TIMEOUT_MS=5000             # per-request timeout with retries
TCGDEX_RETRIES=2                   # retries on 429/5xx
TCGDEX_BACKOFF_MS=300              # exponential backoff base (ms)

########################################
# PokémonTCG API tuning
########################################
PTCG_TIMEOUT_MS=5000
PTCG_RETRIES=2
PTCG_BACKOFF_MS=300

########################################
# CORS
########################################
CORS_ORIGINS=https://tcg.sixbyfive.com,http://tcg.sixbyfive.com,https://tcgdashboard.netlify.app/
